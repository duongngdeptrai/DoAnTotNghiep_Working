@startuml
skinparam defaultTextAlignment center
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F0F4F8
skinparam ActivityBorderColor #4A5568
skinparam ActivityBorderThickness 1.5
skinparam ActivityFontSize 11
skinparam ArrowColor #2D3748
skinparam ConditionStyle diamond
skinparam ConditionBackgroundColor #FEF3C7
skinparam ConditionBorderColor #D97706
skinparam PartitionBackgroundColor #EFF6FF
skinparam PartitionBorderColor #3B82F6
skinparam PartitionFontStyle bold

title Lưu đồ hoạt động Firmware — ESP32 GPS Tracker

start

partition "1. Khởi tạo (Setup)" {
  :Khởi động Serial + Serial2 (UART2);
  :Reset modem qua GPIO25;
  :Khởi động lại modem, bật GPS;

  repeat
    :Kết nối GPRS\n(APN "v-internet");
  repeat while (Đã kết nối GPRS?) is (Chưa)
  -> Rồi;

  repeat
    :Kết nối MQTT Broker\n(broker.emqx.io:1883);
  repeat while (Đã kết nối MQTT?) is (Chưa)
  -> Rồi;

  :Cấu hình GPIO0 INPUT_PULLUP\nĐăng ký ngắt SOS (FALLING edge);
}

partition "2. Vòng lặp chính (Main Loop)" {
  repeat

    if (MQTT còn kết nối?) then (Chưa)
      :Kết nối lại MQTT;
    endif

    :Duy trì keep-alive MQTT;

    if (sosPending = true?) then (Có)
      :Xử lý SOS\n(xem phần 3);
    endif

    if (millis() − lastPublish ≥ 5000 ms?) then (Có)
      :lastPublish = millis();
      :Đọc tọa độ GPS từ modem → cachedGps;
      if (Có tín hiệu GPS?) then (Chưa)
        :Bỏ qua, không publish;
      else (Có)
        :Publish tọa độ GPS lên MQTT;
        :Nhấp nháy LED × 1;
      endif
    endif

  repeat while (Mãi mãi)
}

partition "3. Xử lý SOS (Interrupt Handler)" {
  :sosPending = false;
  :Chờ 50 ms (khử rung);
  if (GPIO0 vẫn ở mức LOW?) then (Không)
    :Bỏ qua (nhiễu);
  else (Có)
    :Đọc GPS mới\n(dùng cachedGps nếu thất bại);
    if (Thời gian từ lần SOS cuối < 10 s?) then (Có)
      :Bỏ qua (cooldown);
    else (Không)
      :lastSosTime = now;
      :Publish SOS payload lên MQTT;
      :Nhấp nháy LED × 3;
    endif
  endif
}

stop
@enduml
